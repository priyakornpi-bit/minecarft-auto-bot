{
	"schemaVersion": 1,
	"id": "template-mod",
	"version": "${version}",
	"name": "Minecraft Auto Bot",
	"description": "Singleplayer helper with toggleable forward movement, emergency stop, and nearby ore mining.",
	"authors": [
		"Minecraft Auto Bot"
	],
	"contact": {
		"sources": ""
	},
	"license": "CC0-1.0",
	"icon": "assets/template-mod/icon.png",
